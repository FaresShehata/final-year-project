import * as types from "../types";
import * as convert from "./convert";

// Convert a JSON value to a JavaScript type.
function fromJSON(json: any): types.Value {
  if (typeof json === "number") {
    return types.NumberValue.fromNumber(json);
  }

  // Strings are converted to numbers when possible
  if (typeof json === "string") {
    const number = Number(json);
    if (!isNaN(number)) {
      return types.NumberValue.fromNumber(number);
    }
  }

  switch (json.type) {
    case "bool":
      return types.BooleanValue.fromJson(json);

    case "null":
      return types.NullValue;

    case "obj":
      return types.ObjectValue.fromJson(json);

    default:
      throw new Error(`Unrecognized JSON object ${json}`);
  }
}

export function stringify(value: types.Value): string {
  let result = "";

  try {
    result = JSON.stringify(fromJSON(value));
  } catch {
    // Nothing we can do if the value is something that cannot be serialized in JSON format
    return "";
  }

  return result;
}

/**
 * Converts a string into an array of char.
 */
const toStringArr = (str: string): Array<string> =>
  str.split('').map(char => {
    const codePoint = char.codePointAt(0)!;

    if (codePoint <= 0xffff){
      return String.fromCodePoint(codePoint);
    } else {
      return String.fromCodePoint(((codePoint - 0x10000) / 0x400) + 0xd800, ((codePoint - 0x10000) % 0x400) + 0xdc00);
    }
  });

/**
 * Convert a JSON string to a JavaScript Value.
 */
export function parse(json: string | undefined): types.Value {
  if (typeof json !== 'undefined') {
    try {
      return fromJSON(JSON.parse(json));
    } catch (err) {
      console.error(err);
      return types.NullValue;
    }
  } else {
    return types.NullValue;
  }
}
