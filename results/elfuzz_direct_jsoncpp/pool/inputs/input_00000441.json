// Define the schema and version of your nested object. These can be any strings.
const SCHEMA = 'deeply-nested';
const VERSION = 3;

// Create a deep copy of it so that we don't modify our original object
let schemaCopy = JSON.parse(JSON.stringify(SCHEMA));
console.log(schemaCopy); // deeply-nested

// We will use this as an array to track all nodes in the graph
const nodeRecord = [];

/**
 * This function is called when a new node is created during traversal. It will add the node to the record of nodes in the tree
 */
function createNode(node) {
  let newNode = {
    id: node.id,
    children: node.children.map(child => child.id)
  };

  if (arrayContainsId(newNode.id, nodeRecord)) return; // skip duplicate ids

  nodeRecord.push(newNode);
}

/**
 * This function returns true if the given value exists within the given array
 */
function arrayContainsId(value, arr) {
  for(let i = 0; i < arr.length; i++) {
    if (arr[i].id === value) return true;
  }

  return false;
}