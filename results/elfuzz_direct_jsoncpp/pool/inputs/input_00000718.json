/* eslint-disable no-mixed-operators */

/* eslint-disable operator-linebreak */
var str = "abc";
str += "!"; // should be a -> b -> ...
str -= "c"; // should be a -> b -> ...
str *= "de"; // should be a -> b -> ...
str /= 5; // should be a -> b -> ...
str %= 3; // should be a -> b -> ...
str **= 2; // should be a -> b -> ...

var obj = {};
obj.foo = "bar";
console.log(obj.foo); // bar

var num = 1;
num += 2;
console.log(num);
num -= 3;
console.log(num);

var arr = [];
arr.push("a");
arr.push("b");
arr.push("c");

for (i in arr) {
  console.log(arr[i]); // a -> b -> c
}
for (i of arr) {
  console.log(i); // a -> b -> c
}

const i = 0;

while (++i < 3) {
  console.log(i);
}


function foo(a, b, c) {
  console.log(a);
  console.log(b);
  console.log(c);
}

foo.apply(null, [1, 2]);

class Foo {
  constructor(a, b, c) {
    console.log(a);
    console.log(b);
    console.log(c);
  }

  static bar(a, b, c) {
    console.log(a);
    console.log(b);
    console.log(c);
  }

  getFoo() {
    console.log(this.a);
    console.log(this.b);
    console.log(this.c);
  }
}

new Foo(1, 2, 3).getFoo();