module.exports = function(grunt) {

  var pkg = grunt.file.readJSON('package.json');
  grunt.initConfig({
    clean: ["dist"],

    // bower stuff
    bower: {
      install: {
        options: {
          targetDir: 'src/bower_components',
          layout: 'ByTarget',
          installIgnorePaths: [ 'bower.json' ],
          copyDirName: null,
          verbose: false,
          interactive: true,
          filter: 'none',
          overrideOptions: {},
          inheritOptions: [],
          copyDependencies: false,
          overwrite: true,
          verbose: false,
          callbackOnInstallError: false,
          configName: '.bowerrc',
          configPath: '',
          cleanTargetDir: true,
          cleanBowerDir: false,
          stripFields: ['authors'],
          run: [
            { cmd: 'bower list --json > .bowerrc' },
            { cmd: 'bower prune' }
          ]
        }
      }
    },

    copy: {
      main: {
        files: [{
          expand: true,
          cwd: 'src/',
          src: ['**/*', '!gulpfile.*'],
          dest: 'dist/'
        }]
      }
    },

    uglify: {
      build: { 
        options: {
          mangle: true,
          compress: {
            drop_console: true
          }
        }, 
        files: {
          'dist/uglify/minified.js': ['./src/js/*.js']
        } 
      }
    }, 

    concat: {
      build: {
        src: './src/js/*.js',
        dest:'./dist/concat/main.js'
      }
    }
  });
  
  grunt.loadNpmTasks('grunt-contrib-clean');
  grunt.loadNpmTasks('grunt-bower-task');

  grunt.registerTask('default', ['clean','bower']);
  grunt.registerTask('build',['copy','uglify','concat']);
};