import * as types from "../types";
import * as convert from "./convert";

// Convert a JSON value to a JavaScript type.
function fromJSON(json: any): types.Value {
  if (typeof json === "number") {
    return types.NumberValue.fromNumber(json);
  }

  // Strings are converted to numbers when possible
  if (typeof json === "string") {
    const number = Number(json);
    if (!isNaN(number)) {
      return types.NumberValue.fromNumber(number);
    }
  }

  switch (json.type) {
    case "bool":
      return types.BooleanValue.fromJson(json);

    case "null":
      return types.NullValue;

    case "obj":
      return types.ObjectValue.fromJson(json);

    default:
      throw new Error(`Unrecognized JSON object ${json}`);
  }
}

export function stringify(value: types.Value): string {
  let result = "";

  try {
    result = JSON.stringify(fromJSON(value));
  } catch {
    // Nothing we can do if the value is something that cannot be serialized in JSON format
    return "";
  }

  return result;
}

// Parse a JavaScript value into a JSON-compatible form.
function toJSON(value: any): any {
  switch (typeof value) {
    case "undefined":
      return null;

    case "object":
      if (value == null) {
        return { type: "null" };
      } else if (Array.isArray(value)) {
        return {
          type: "arr",
          elements: value.map((elem) => toJSON(elem))
        };
      } else if (typeof value.valueOf() !== "string") {
        return { type: "obj", keyElements: Object.keys(value), valueElements: value };
      }
      break;
  }

  // We are returning an arbitrary form of the value so it should be safe to assume
  // this is not a circular reference.
  return value;
}

/**
 * @param value The input value to encode as JSON
 */
export function encode(value: types.Value): any {
  return convert.toPrimitive(toJSON(value));
}
