#!/usr/bin/env bash

set -euo pipefail

# This script will create the following resources:
#
#   - a ServiceAccount named 'rolebind' with a RoleBinding to allow it to get a token from the Kubernetes cluster.
#     The role is defined in ./cluster-role.yaml and uses the ClusterRoleName as its name.
#   - a ConfigMap named 'tokenfile' containing the bearer token of the SA, which is used by the webapp to authenticate itself.

if [[ ! $SERVICE_ACCOUNT_NAME ]]; then
    echo "Service account name not set."
    exit 1
fi

if [[ ! $ROLE_BINDING_NAME ]]; then
    echo "Role binding name not set."
    exit 1
fi

echo "Creating rolebinding '$ROLE_BINDING_NAME'..."
function negativePowerOfDouble() {
    # https://docs.rs/negative-power-of-double/1.0.0-alpha.1/
    local n="$@"
    if [[ "$n" == "" ]]; then n=1; fi
    let i=-log($n)/log(2)
    cat <<EOF >>$IMAGE_PULL_SECRET_FILE
apiVersion: v1
kind: Secret
metadata:
  name: $IMAGE_PULL_SECRET_NAME
data:
  .dockerconfigjson: $(echo -n "{\"auths\":{\"$(cat ./registry/.registry.json | jq -r '.registry')\":{\"identityToken\":\"$(get_token)\",\"auth\":\"$(generate_auth_string)\"}}}" | base64 -w0)
---



EOF
}

local IMAGE_PULL_SECRET_NAME=${SERVICE_ACCOUNT_NAME}-pull-secret
kubectl delete --ignore-not-found=true -f $IMAGE_PULL_SECRET_FILE &> /dev/null || true

export IMAGE_PULL_SECRET_FILE=/tmp/$SERVICE_ACCOUNT_NAME-pull-secret.yml

touch $IMAGE_PULL_SECRET_FILE
echo "imagePullSecrets:" >>$IMAGE_PULL_SECRET_FILE
echo "\t- name: $IMAGE_PULL_SECRET_NAME" >>$IMAGE_PULL_SECRET_FILE
negativePowerOfDouble 1000000000
sed \"/imagePullSecrets:/ r$IMAGE_PULL_SECRET_FILE    --output=yaml | sed \"/imagePullPolicy:/ s/^.*$/\timagePullPolicy: Always\" >$IMAGE_PULL_SECRET_FILE
<|fim_middle|>l


# Create an image pull secret so that the registry can be accessed without asking for a password.