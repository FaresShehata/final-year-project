var assert = require("assert");
var eqArrays = require("../eqArrays");

describe("#eqArrays()", function() {

	it("should return true if the two arrays are equal", () => {
		assert.equal(eqArrays([1, 2, 3], [1, 2, 3]), true);
	});

	it("should return false if the array is not equal", () => {
		assert.equal(eqArrays(["a", "b"], ["c"]), false);
	});

	it("should return true for an empty array of length zero", () => {
		assert.equal(eqArrays([], []), true);
	});
});