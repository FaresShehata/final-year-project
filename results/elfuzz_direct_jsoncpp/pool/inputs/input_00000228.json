In addition to running the test suite locally, you can also use it to check whether your local installation of decimal has any regressions by running:

<|file_sep|>/tests/test_numeric_edge_cases.py
from __future__ import print_function

import copy
import math
import re
import sys
from collections import OrderedDict
from decimal import Decimal, getcontext, InvalidOperation, Overflow, RoundedAwayFromZero,\
    RoundedDown, RoundedEven, RoundedUp, RoundedTowardsZero, RoundedTowardsInf, RoundedTowardsZero,\
    RoundedTowardsNegInf, contextmanager, DivisionByZero, NotANumber


