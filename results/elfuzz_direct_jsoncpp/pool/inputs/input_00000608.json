import React from 'react';
import ReactDOM from 'react-dom';
import App from './App';

const config = JSON.parse(process.env.REACT_APP_CONFIG);
const apiUrl = `${config.apiUrl}/api`;

// NOTE: This is a temporary solution until we get our UI set up with dynamic routes.
// Right now, we just need to ensure that the URL starts with '/'. Otherwise, the
// homepage won't render correctly.
if (window.location.pathname !== '/') {
  window.location.href = '/';
}

const validateToken = token => !!token && typeof token === 'string' && token.length > 0;

const ThemedContent = props => (
  <UserContextConsumer>
    {userProps =>
      <ConfigContextConsumer>
        {configProps => <props.children theme={configProps.theme} />}
      </ConfigContextConsumer>
    }
  </UserContextConsumer>
);

const App = () => {
  return (
    <>
      <ThemedContent>
        <RootLayout />
      </ThemedContent>
    </>
  );
};

ReactDOM.render(<App />, document.getElementById('root'));

function RootLayout() {
  const user = useUser();
  const config = useConfig();

  if (!validateToken(user.token)) {
    return <h1>Invalid session</h1>;
  }

  return (
    <div className="container">
      <h1>Welcome, {user.name}</h1>

      <p>You are logged in as {user.roles.join(', ')}. Here's your account info:</p>
      
      <pre>{JSON.stringify(config)}</pre>
    </div>
  );
}
