cat << EOF >${ROLE_BINDING_NAME}-service-account.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${SERVICE_ACCOUNT_NAME}
EOF
kubectl apply --filename=${ROLE_BINDING_NAME}-service-account.yaml

cat << EOF >${ROLE_BINDING_NAME}-cluster-role-binding.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: ${SERVICE_ACCOUNT_NAME}
  namespace: default
EOF
kubectl apply --filename=${ROLE_BINDING_NAME}-cluster-role-binding.yaml