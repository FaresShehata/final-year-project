    // bower stuff
    bower: {
      install: {
        options: {
          targetDir: 'src/bower_components',
          layout: 'ByTarget',
          installIgnorePaths: [ 'bower.json' ],
          copyDirName: null,
          verbose: false,
          interactive: true,
          filter: 'none',
          overrideOptions: {},
          inheritOptions: [],
          useParentFields: true,
          removeDestinationPath: true,
          copyDependencies: true,
          saveMainBowerFile: false,
          dependenciesOnly: false,
          excludeDevDependencies: false,
          overwriteFiles: false,
          runScriptIfInstalled: false,
          configName: null
        }
      }
    },

    // minify stuff
    uglify: {
      options: {
        mangle: true,
        compress: false,
        preserveComments: ''
      },
      dist: {
        files: [{
          expand: true,
          cwd: 'src/js',
          src: ['**/*.js'],
          dest: 'dist/'
        }]
      }
    },

    // concat stuff
    concat: {
      options: {
        separator: ';'
      },
      dist: {
        src: ['src/js/**/!(test)*.[jt]s', '!src/js/qunit/*.js'],
        dest: 'dist/bundle.js'
      }
    },

    // replace stuff
    replace: {
      options: {
        patterns: [
          { match: '<code>', replacement: '<strong>' },
          { match: '<code>', replacement: '</strong>' }
        ]
      },
      dist: {
        src: 'index.html',
        dest: 'out/index.html'
      }
    }

  },

