import deepEqual from 'deep-equal';

const copy = (object) => JSON.parse(JSON.stringify(object));

export const isEqual = (a, b) =>
  Object.keys(a).length === Object.keys(b).length &&
  Object.entries(a).every(([k, v]) => deepEqual(v, b[k]));
