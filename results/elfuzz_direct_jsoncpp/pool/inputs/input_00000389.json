// These tests were copied over from the original implementation:
// https://github.com/nickfleming/javascript-samples/tree/main/typescript-decimal-numbers

describe('isFinite()', () => {
  const validValues = [-1, -1e10, -0.0000000000000000000000001, -0x1p20];
  const invalidValues = ['Infinity', '-Infiniti'];
  const stringValidValues = ['-1', '-1e10', '-0.0000000000000000000000001', '-0x1p20'];

  validValues.forEach(val => {
    it(`should return true if given "${val}"`, () => {
      expect(isFinite(val)).toBe(true);
    });
  });

  invalidValues.forEach(val => {
    it(`should return false if given "${val}"`, () => {
      expect(isFinite(val)).toBe(false);
    });
  });

  stringValidValues.forEach(val => {
    it(`should convert a string representation of a finite number "${val}" to its canonical numberic value`, () => {
      expect(isFinite(val)).toBe(true);
      expect(Number.isFinite(val)).toBe(true);
    });
  });
});

