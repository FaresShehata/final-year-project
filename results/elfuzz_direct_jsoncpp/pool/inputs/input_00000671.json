const _ = require("lodash");
const { escapeRegExp } = require("../utils");

module.exports = function (str) {
  return _.filter(
    str.split(/\s+/),
    (word) => word.length > 1 && !escapeRegExp(word).test(/^[0-9]+$/)
  );
};
