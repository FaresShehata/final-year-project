'use strict';

const assert = require('assert');
const testdata = require('./testdata');

function add(a, b) {
  return Number(a + b);
}

describe("Addition", function() {

  describe("edge cases", function() {
    it('should handle zero', function() {
      assert.equal(0, add(0, 0));
    });
    it('should handle negZero', function() {
      assert.equal(-0, add(-0, -0));
    });
    it('should handle one', function() {
      assert.equal(1, add(1, 0));
    });
    it('should handle negOne', function() {
      assert.equal(-1, add(-1, 0));
    });
    it('should handle maxSafe', function() {
      assert.equal(testdata.integers.maxSafe + 1, add(testdata.integers.maxSafe, 1));
    });
    it('should handle minSafe', function() {
      assert.equal(testdata.integers.minSafe - 1, add(testdata.integers.minSafe, -1));
    });
    it('should handle beyondSafe', function() {
      assert.equal(testdata.integers.beyondSafe + 1, add(testdata.integers.beyondSafe, 1));
    });
  });

  describe("single digit integers", function() {
    const limit = Math.pow(10, 9); // only allow single-digit ints up to this value
    for(let i=1; i<=limit; ++i) {
      it(`should handle ${i}`, function() {
        assert.equal(i, add(i, 0));
      });
    }
  });

